- name: test vars
  hosts: localhost
  vars:
    app_version: 2.0
  tasks: 
   - debug:
       msg: "version is {{app_version}}"
   - debug:
       var: ansible_facts
   - copy:
       content: |
        version is {{ app_version }}
        {{ ansible_facts | to_nice_yaml }}
       dest: /home/ec2-user/Ansible/Basic
